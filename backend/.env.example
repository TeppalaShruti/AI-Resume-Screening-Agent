# Copy to .env and fill in. The agent runs fully without an API key
# (deterministic template reasoning is used as a fallback).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding model used for semantic JD <-> resume similarity
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# CORS origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=*
